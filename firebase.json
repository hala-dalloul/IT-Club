{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8085
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "hosting": {
    "public": "dist/client",
    "rewrites": [
      {
        "destination": "/_shell.html",
        "source": "**"
      }
    ],
    "headers": [
      {
        "headers": [
          {
            "value": "public,max-age=31536000,immutable",
            "key": "Cache-Control"
          }
        ],
        "source": "/assets/**"
      }
    ],
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
  }
}
