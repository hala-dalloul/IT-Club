rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function admin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['editor','super_admin']; }
  function superAdmin() { return admin() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin'; }
  function text(value, min, max) { return value is string && value.size() >= min && value.size() <= max; }
  function email(value) { return text(value,3,254) && value.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$'); }
  function commonContent() { let d=request.resource.data; return d.keys().hasAll(['title','title_en','description','description_en','images','updatedAt','updatedBy']) && d.keys().hasOnly(['title','title_en','description','description_en','images','updatedAt','updatedBy','category','year','technologies','memberIds','role','role_en','committee','isFounder','date','status','partnershipType','partnershipType_en','websiteUrl','githubUrl','linkedinUrl','demoUrl','apkUrl']) && text(d.title,2,200) && text(d.title_en,2,200) && text(d.description,2,20000) && text(d.description_en,2,20000) && d.images is list && d.images.size() <= 20 && d.updatedAt == request.time && d.updatedBy == request.auth.uid; }
  function contentValid(kind) { let d=request.resource.data; return commonContent() && (kind != 'projects' || (d.category in ['web','mobile','games','multimedia'] && d.year is int && d.year >= 2000 && d.year <= 2100 && d.memberIds is list && d.memberIds.size() <= 100 && d.technologies is list && d.technologies.size() <= 50)) && (kind != 'members' || (d.committee in ['media','relations','activities','development'] && d.isFounder is bool && text(d.role,0,200) && text(d.role_en,0,200))) && (!(kind in ['events','achievements']) || (d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))) && (kind != 'events' || d.status in ['upcoming','past']); }
  match /{kind}/{id} {
   allow read: if kind in ['projects','members','events','achievements','partners'];
   allow create,update: if kind in ['projects','members','events','achievements','partners'] && admin() && contentValid(kind);
   allow delete: if kind in ['projects','members','events','achievements','partners'] && admin();
  }
  match /settings/public {
   allow read: if true;
   allow create,update: if superAdmin() && request.resource.data.keys().hasOnly(['vision','vision_en','mission','mission_en','goals','goals_en','email','facebook','instagram','linkedin','github']) && request.resource.data.keys().hasAll(['vision','vision_en','mission','mission_en','goals','goals_en','email','facebook','instagram','linkedin','github']) && text(request.resource.data.vision,0,10000) && text(request.resource.data.vision_en,0,10000) && text(request.resource.data.mission,0,10000) && text(request.resource.data.mission_en,0,10000) && text(request.resource.data.goals,0,10000) && text(request.resource.data.goals_en,0,10000) && text(request.resource.data.email,0,254) && text(request.resource.data.facebook,0,2048) && text(request.resource.data.instagram,0,2048) && text(request.resource.data.linkedin,0,2048) && text(request.resource.data.github,0,2048);
  }
  match /admins/{uid} {
   allow get: if signedIn() && (request.auth.uid == uid || superAdmin());
   allow list: if superAdmin();
   allow create: if superAdmin() && uid != request.auth.uid && request.resource.data.keys().hasOnly(['uid','name','email','role']) && request.resource.data.uid == uid && request.resource.data.role == 'editor' && text(request.resource.data.name,2,200) && email(request.resource.data.email);
   allow update: if superAdmin() && uid != request.auth.uid && resource.data.role == 'editor' && request.resource.data.role == 'editor' && request.resource.data.uid == uid && request.resource.data.keys().hasOnly(['uid','name','email','role']) && text(request.resource.data.name,2,200) && email(request.resource.data.email);
   allow delete: if superAdmin() && uid != request.auth.uid && resource.data.role == 'editor';
  }
  match /joinRequests/{id} {
   allow create: if request.resource.data.keys().hasOnly(['fullName','email','phone','studentId','major','preferredCommittee','message','status','submittedAt']) && text(request.resource.data.fullName,2,200) && email(request.resource.data.email) && text(request.resource.data.phone,0,30) && text(request.resource.data.studentId,3,30) && text(request.resource.data.major,2,200) && request.resource.data.preferredCommittee in ['media','relations','activities','development'] && text(request.resource.data.message,10,4000) && request.resource.data.status == 'new' && request.resource.data.submittedAt == request.time;
   allow read: if admin();
   allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status in ['new','accepted','rejected','archived'];
  }
  match /contactMessages/{id} {
   allow create: if request.resource.data.keys().hasOnly(['name','email','message','submittedAt','isRead']) && text(request.resource.data.name,2,200) && email(request.resource.data.email) && text(request.resource.data.message,10,4000) && request.resource.data.isRead == false && request.resource.data.submittedAt == request.time;
   allow read: if admin();
   allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) && request.resource.data.isRead is bool;
  }
 }
}
